{
  "name": "qiaomu-reader-dsh",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "description": "乔木阅读：DSH 的 EPUB、PDF、TXT、Markdown、HTML 阅读器，支持朗读、生词本、阅读笔记与原生 AI 伴读。",
  "exports": {
    ".": "./index.js",
    "./index.js": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "index.js",
    "locale/*.json",
    "docs/qa/adaptation-*.png",
    "docs/READER-ADAPTATION.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "books": "node scripts/make-starter-books.mjs",
    "resources": "node scripts/generate-pdf-resources.mjs",
    "prepack": "npm run build && node scripts/verify-package.mjs",
    "check": "npm run build && npm test && node scripts/verify-package.mjs"
  },
  "meta": {
    "title": "乔木阅读",
    "description": "乔木阅读：DSH 的 EPUB、PDF、TXT、Markdown、HTML 阅读器，支持朗读、生词本、阅读笔记与原生 AI 伴读。"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "meta": {
      "title": "乔木阅读",
      "description": "乔木阅读：DSH 的 EPUB、PDF、TXT、Markdown、HTML 阅读器，支持朗读、生词本、阅读笔记与原生 AI 伴读。"
    }
  },
  "dependencies": {
    "marked": "18.1.2",
    "parse5": "8.0.1",
    "pdfjs-dist": "^6.2.108"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joeseesun/qiaomu-reader-dsh.git"
  },
  "homepage": "https://github.com/joeseesun/qiaomu-reader-dsh#readme",
  "bugs": {
    "url": "https://github.com/joeseesun/qiaomu-reader-dsh/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "qiaomu",
    "epub",
    "reading"
  ]
}
